---
import { SEO } from "astro-seo";
import "../assets/app.css";

interface Props {
  title?: string;
  description?: string;
  tone?: "light" | "dark";
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}

const {
  title = "TradeCommand — AI-native job management for trades",
  description =
    "Job management for electricians, plumbers and builders, with Claude built in. Leads, quotes, jobs, variations, purchase orders, timesheets and invoices, and an inbox that turns an enquiry into a lead.",
  tone = "light",
  noindex = false,
  schema = [],
} = Astro.props;

const dark = tone === "dark";

const site = Astro.site!;
// build.format "file" makes the pathname /privacy.html; every link says /privacy.
const canonical = new URL(Astro.url.pathname.replace(/(index)?\.html$/, ""), site).toString();
const image = new URL("/og.png", site).toString();
const imageAlt = "TradeCommand: run the job, let the AI run the office. An enquiry turned into a lead for a person to approve.";

const organization = {
  "@type": "Organization",
  "@id": new URL("/#organization", site).toString(),
  name: "TradeCommand",
  legalName: "TC Systems Pty Ltd",
  url: site.toString(),
  logo: new URL("/icon.png", site).toString(),
  email: "hello@tradecommand.com.au",
  areaServed: "AU",
};

const graph = JSON.stringify({ "@context": "https://schema.org", "@graph": [organization, ...schema] });
---

<!doctype html>
<html lang="en-AU" data-theme="tradecommand">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={dark ? "#1d1210" : "#fefbfa"} />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: { title, type: "website", image, url: canonical },
        optional: { description, siteName: "TradeCommand", locale: "en_AU" },
        image: { url: image, secureUrl: image, type: "image/png", width: 1200, height: 630, alt: imageAlt },
      }}
      twitter={{ card: "summary_large_image", title, description, image, imageAlt }}
    />

    <script is:inline type="application/ld+json" set:html={graph} />

    <link rel="preload" href="/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class:list={["min-h-dvh antialiased", dark ? "bg-ground text-white" : "bg-base-100 text-base-content"]}>
    <slot />
  </body>
</html>
