---
import { SEO } from "astro-seo";
import "../assets/app.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TradeCommand — AI-native job management for trades",
  description =
    "AI-native job management for electricians, plumbers and builders. Leads, quotes, jobs, variations, purchase orders, timesheets and invoices, with an inbox agent that turns an enquiry into a lead. Coming soon.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en-AU" data-theme="tradecommand">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fefbfa" />
    <meta name="generator" content={Astro.generator} />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: { title, type: "website", image: new URL("/icon.png", Astro.site).toString(), url: canonical },
        optional: { description, siteName: "TradeCommand", locale: "en_AU" },
        image: { alt: "The TradeCommand mark." },
      }}
      twitter={{ card: "summary" }}
    />

    <link rel="preload" href="/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="bg-base-100 text-base-content min-h-dvh antialiased">
    <slot />
  </body>
</html>
