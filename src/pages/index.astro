---
import Layout from "../layouts/Layout.astro";

const APP_URL = "https://app.tradecommand.com.au";
const year = new Date().getFullYear();
---

<Layout>
  <div class="paper-grain min-h-dvh flex flex-col items-center justify-center px-6 py-12 sm:px-10 sm:py-16">
    <main class="w-full max-w-3xl text-center">
      <div class="inline-flex items-center gap-2.5">
        <span class="brand-fill grid place-items-center size-8 rounded-selector bg-primary text-primary-content font-bold shrink-0">T</span>
        <span class="text-lg font-semibold tracking-tight">TradeCommand</span>
      </div>

      <p class="mt-6">
        <span class="inline-flex items-center gap-2 rounded-selector border border-base-300 bg-base-100 px-3 py-1.5 text-sm text-base-content/70">
          <span class="size-1.5 rounded-full bg-link"></span>Coming soon
        </span>
      </p>

      <h1 class="mt-7 text-[2.5rem] leading-[1.06] sm:text-[3.5rem] lg:text-6xl font-bold tracking-tight text-balance">
        AI-native job management<br />
        <span class="text-link">for trades.</span>
      </h1>

      <p class="mt-6 mx-auto max-w-xl text-lg text-base-content/70 leading-relaxed text-pretty">
        For electricians, plumbers and builders. Leads, quotes, jobs, variations, purchase
        orders, timesheets and invoices — and an inbox that turns an enquiry into a lead
        before you have read it.
      </p>

      <p class="mt-10 text-base text-base-content/60">
        Already have an account?
        <a href={`${APP_URL}/session/new`} class="text-link font-semibold underline underline-offset-4 hover:no-underline">Sign in</a>
      </p>
    </main>

    <footer class="mt-24 text-sm text-base-content/45">
      <nav class="flex justify-center gap-x-5">
        <a href="/privacy" class="hover:text-base-content">Privacy</a>
        <a href="/terms" class="hover:text-base-content">Terms</a>
        <a href="/data-deletion" class="hover:text-base-content">Data deletion</a>
        <a href="/support" class="hover:text-base-content">Support</a>
      </nav>
      <p class="mt-3">&copy; {year} TradeCommand — a TC-Systems product, built in Australia.</p>
    </footer>
  </div>
</Layout>

<style>
  /* Near-white warm paper with one soft coral glow behind the mark. The primary is a fill colour and
     this is the only place on the page it appears at any size — keep it faint, or the paper stops
     reading as paper and the coral badge loses the ground it needs to sit against. */
  .paper-grain {
    background-color: var(--color-base-100);
    background-image:
      radial-gradient(52rem 26rem at 50% -6%, color-mix(in oklch, var(--color-primary) 16%, transparent) 0%, transparent 72%);
  }
</style>
