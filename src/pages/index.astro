---
import Layout from "../layouts/Layout.astro";
import Brand from "../components/Brand.astro";
import Icon from "../components/Icon.astro";
import EarlyAccessForm from "../components/EarlyAccessForm.astro";
import InboxFlow from "../components/InboxFlow.astro";
import SiteFooter from "../components/SiteFooter.astro";

const APP_URL = "https://app.tradecommand.com.au";
const SIGN_IN = `${APP_URL}/session/new`;
const EARLY_ACCESS = "#early-access";

const nav = [
  { href: "#ai", label: "AI" },
  { href: "#work", label: "Lead to paid" },
  { href: "#site", label: "On site" },
  { href: "#connects", label: "Connects" },
  { href: "#questions", label: "Questions" },
];

const duties = [
  {
    icon: "mail",
    when: "An enquiry lands in the inbox.",
    then: "The bot reads it, checks whether they’re already a client, and writes up the lead with the address and the trade.",
  },
  {
    icon: "file",
    when: "A supplier emails an invoice.",
    then: "It reads the PDF, matches it to your purchase order, and drafts the bill against the right job.",
  },
  {
    icon: "chat",
    when: "Someone on site sends a WhatsApp.",
    then: "It works out which job they mean and puts the photo, note or task on it, where the office will see it.",
  },
] as const;

const modes = [
  { name: "Off", body: "It does nothing." },
  { name: "Ask me first", body: "It does the work, then waits for you to OK each step." },
  { name: "On", body: "It gets on with it, and you can see everything it did." },
];

const pipeline = [
  { name: "Lead", body: "From email, a phone call or your website. Someone owns it, so it never dies in an inbox." },
  { name: "Quote", body: "Built from your own price list and sent to the client to accept online." },
  { name: "Job", body: "Starts from the accepted quote. Crew, tasks, photos and files all in one spot." },
  { name: "Variation", body: "Extra work priced and approved by the client before anyone starts on it." },
  { name: "Invoice", body: "Sent to the client, marked paid, and pushed to Xero against the job." },
];

const supply = ["Purchase orders", "Supplier bills", "Stock", "Products", "Suppliers", "Job costing"];

const site = [
  { icon: "pin", title: "Clock on at the job", body: "Time goes straight onto the job. Your location is only checked the moment you clock on or off." },
  { icon: "camera", title: "Photo sign-off", body: "A task can need a photo before it’s ticked off, so the office knows the work is done." },
  { icon: "calendar", title: "Rosters and timesheets", body: "Send out the week’s roster, and approve a whole week of timesheets in one go." },
  { icon: "user", title: "A portal for the client", body: "Clients accept quotes, approve variations and pick their fittings online, without a phone call." },
] as const;

const integrations = [
  { name: "Xero", src: "/integrations/xero.svg", body: "Invoices and bills go straight into Xero, against the right job." },
  { name: "Deputy", icon: "clock", body: "Pulls in rosters and approved hours from Deputy." },
  { name: "Microsoft 365", icon: "box", body: "Job files saved to OneDrive, tasks synced with Planner, and new work picked up from Outlook." },
  { name: "WhatsApp", icon: "phone", body: "Messages to your business number come into TradeCommand, and you reply from there." },
] as const;

const faqs = [
  {
    question: "What is TradeCommand?",
    answer: "Job management for electricians, plumbers and builders: leads, quotes, jobs, variations, purchase orders, timesheets and invoices in one app. The AI does the office work in between.",
  },
  {
    question: "Does the AI act without asking?",
    answer: "Only if you let it. Each bot is set to Off, Ask me first, or On. On Ask me first it does all the work and waits for your OK before anything happens. It’s the easy way to find out whether you trust it.",
  },
  {
    question: "Which AI does it use?",
    answer: "Claude, made by Anthropic. Only the text a bot needs is sent to Anthropic, and they don’t train their models on it. You can also connect Claude, or any assistant that supports MCP, and ask it about your jobs.",
  },
  {
    question: "Does it work on site?",
    answer: "Yes. The iPhone and iPad app uses the same login as the office. Your team clocks on, takes photos, ticks off tasks and hears about new jobs straight away.",
  },
  {
    question: "Do I still need Xero?",
    answer: "Yes. TradeCommand runs the jobs and Xero stays your books. Invoices and bills go into Xero against the job, so your job costing there still adds up.",
  },
  {
    question: "When can I use it?",
    answer: "Now, a few businesses at a time. Fill in the form below and we’ll email you an invite code.",
  },
];

const product = {
  "@type": "SoftwareApplication",
  name: "TradeCommand",
  url: "https://tradecommand.com.au/",
  description: "Job management for electricians, plumbers and builders, with AI that runs the office.",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web, iOS",
  publisher: { "@id": "https://tradecommand.com.au/#organization" },
};

const faqPage = {
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<Layout tone="dark" schema={[product, faqPage]}>
  <div class="dots bg-ground text-white [--link:var(--color-brand)]">
    <header class="border-b border-white/8">
      <div class="wrap h-[68px] lg:h-[88px] flex items-center justify-between gap-6">
        <a href="#top" class="flex items-center gap-2.5 lg:gap-3 text-white">
          <Brand />
        </a>
        <nav class="hidden lg:flex items-center gap-9 text-[15px] font-medium" aria-label="Sections">
          {nav.map((item) => <a href={item.href} class="text-fog-300 hover:text-white">{item.label}</a>)}
        </nav>
        <div class="flex items-center gap-2.5">
          <a href={SIGN_IN} class="inline-flex min-h-11 items-center rounded-lg border border-white/22 px-3.5 text-[15px] font-semibold text-white hover:border-white/45 sm:border-transparent sm:px-[18px] sm:hover:border-transparent sm:hover:text-fog-200">Sign in</a>
          <a href={EARLY_ACCESS} class="hidden sm:inline-flex min-h-11 items-center rounded-lg bg-brand px-5 text-[15px] font-bold text-brand-ink hover:bg-brand-400">Get early access</a>
        </div>
      </div>
    </header>

    <section id="top" class="wrap pt-10 pb-12 sm:pt-16 sm:pb-20 lg:pt-[88px] lg:pb-[104px] grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-16 lg:items-center">
      <div class="flex flex-col gap-[22px] lg:gap-7">
        <h1 class="font-display text-[46px] leading-none font-extrabold tracking-[-0.035em] sm:text-[64px] lg:text-[58px] lg:leading-[0.98] xl:text-[76px]">
          Run the job. <span class="text-brand">Let the AI run the office.</span>
        </h1>
        <p class="max-w-[520px] text-[17px] leading-[1.55] text-pretty text-fog-300 lg:text-xl">
          Job management for electricians, plumbers and builders. Enquiries become leads and supplier invoices become bills while you’re on the tools, and you decide what it does without asking.
        </p>
        <div class="flex flex-col gap-3.5 sm:flex-row sm:items-center lg:mt-2">
          <a href={EARLY_ACCESS} class="cta">
            Get early access
            <Icon name="arrow" class="size-[18px]" stroke={2.2} />
          </a>
          <a href="#ai" class="cta-ghost hidden sm:inline-flex">See what it does</a>
        </div>
        <p class="-mt-1.5 text-center text-sm text-fog-400 sm:mt-0 sm:text-left lg:text-[15px]">
          <strong class="text-white">Built in Coffs Harbour</strong> for Aussie trades. On the web, iPhone and iPad.
        </p>
      </div>

      <div class="mt-3 sm:mx-auto sm:w-full sm:max-w-[560px] lg:mt-0 lg:max-w-none">
        <InboxFlow />
      </div>
    </section>
  </div>

  <main>
    <section id="ai" class="border-t border-brand/18 bg-ground-800 text-white [--link:var(--color-brand)]">
      <div class="wrap py-14 sm:py-24 lg:pt-[136px] lg:pb-36 flex flex-col gap-10 lg:gap-14">
        <div class="flex max-w-[900px] flex-col gap-5 lg:gap-[18px]">
          <p class="eyebrow text-brand">01 — AI in the office</p>
          <h2 class="heading-section">Admin sorted before you’re back in the ute.</h2>
          <p class="max-w-[680px] text-[17px] leading-[1.6] text-pretty text-fog-300 lg:text-[19px]">
            Give a bot a job, like reading the inbox. It joins your team under its own name and can only do what you let it.
          </p>
        </div>

        <ul class="grid gap-3 sm:gap-4 md:grid-cols-3">
          {duties.map((duty) => (
            <li class="row-span-2 grid grid-rows-subgrid gap-4 rounded-[18px] border border-white/12 bg-white/4 p-5 transition-colors hover:border-brand/60 sm:p-6">
              <div class="flex flex-col gap-4">
                <span class="grid size-11 place-items-center rounded-xl bg-white text-ink-900">
                  <Icon name={duty.icon} class="size-[22px]" stroke={1.8} />
                </span>
                <h3 class="font-display text-xl leading-[1.2] font-bold tracking-[-0.02em] text-balance lg:text-[22px]">{duty.when}</h3>
              </div>
              <p class="flex gap-2.5 self-start border-t border-white/10 pt-4 text-[15px] leading-[1.5] text-fog-200">
                <Icon name="spark" class="mt-0.5 size-[18px] shrink-0 text-brand" />
                {duty.then}
              </p>
            </li>
          ))}
        </ul>

        <div class="grid gap-6 rounded-[20px] border border-brand/25 bg-ground-700 p-6 sm:p-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-12 lg:p-10">
          <div class="flex flex-col gap-3">
            <h3 class="font-display text-[26px] leading-[1.1] font-bold tracking-[-0.02em] lg:text-[32px]">You decide how far it goes.</h3>
            <p class="text-[15px] leading-[1.6] text-fog-300 lg:text-base">Every bot has a setting, and everything it does is logged with exactly what it read.</p>
          </div>
          <ol class="grid gap-2.5 sm:grid-cols-3">
            {modes.map((mode, i) => (
              <li class:list={["flex flex-col gap-2 rounded-2xl border p-4 sm:p-5", i === 1 ? "border-brand bg-brand/10" : "border-white/12 bg-white/4"]}>
                <p class:list={["font-mono text-xs font-semibold tracking-[0.06em] uppercase", i === 1 ? "text-brand-400" : "text-fog-300"]}>{mode.name}</p>
                <p class="text-[15px] leading-[1.5] text-fog-100">{mode.body}</p>
              </li>
            ))}
          </ol>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
          <p class="max-w-[640px] text-[17px] leading-[1.55] text-fog-200">
            <strong class="text-white">Prefer your own AI?</strong> Connect Claude, or any assistant that supports MCP, and ask it which invoices are overdue or who’s booked in for Thursday.
          </p>
          <ul class="flex flex-wrap gap-2">
            <li class="flex items-center gap-2.5 rounded-full bg-white py-1.5 pr-4 pl-1.5 text-[15px] font-semibold text-ink-900">
              <span class="grid size-8 place-items-center rounded-full bg-mist"><img loading="lazy" decoding="async" src="/assistants/claude.svg" alt="" class="size-5" width="20" height="20" /></span>
              Claude
            </li>
            <li class="flex items-center gap-2.5 rounded-full border border-dashed border-white/30 py-1.5 pr-4 pl-1.5 text-[15px] font-semibold text-fog-200">
              <span class="grid size-8 place-items-center rounded-full bg-white/8 text-brand"><Icon name="plus" class="size-4" stroke={2.4} /></span>
              Any MCP assistant
            </li>
          </ul>
        </div>
      </div>
    </section>

    <section id="work" class="bg-mist text-ink-900">
      <div class="wrap py-14 sm:py-24 lg:pt-[136px] lg:pb-36 flex flex-col gap-10 lg:gap-14">
        <div class="flex max-w-[900px] flex-col gap-5 lg:gap-[18px]">
          <p class="eyebrow text-brand-700">02 — Lead to paid</p>
          <h2 class="heading-section">From the first phone call to getting paid.</h2>
          <p class="max-w-[680px] text-[17px] leading-[1.6] text-ink-600 lg:text-[19px]">
            Each step links back to the one before, so the job always shows the quote it came from and every variation since.
          </p>
        </div>

        <ol class="grid gap-x-4 gap-y-8 sm:grid-cols-2 lg:grid-cols-5">
          {pipeline.map((step, i) => (
            <li class:list={["flex flex-col gap-2.5 border-t-[3px] pt-6 lg:gap-3 lg:pt-7", i === pipeline.length - 1 ? "border-brand-600" : "border-ink-900"]}>
              <p class="font-mono text-[13px] font-semibold text-brand-700 lg:text-sm">0{i + 1}</p>
              <h3 class="font-display text-[22px] font-bold tracking-[-0.02em] lg:text-[26px]">{step.name}</h3>
              <p class="text-[15px] leading-[1.6] text-ink-600">{step.body}</p>
            </li>
          ))}
        </ol>

        <div class="flex flex-col gap-4 rounded-2xl border border-line bg-white p-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8 sm:px-7 sm:py-6">
          <div class="flex flex-col gap-1">
            <h3 class="font-display text-xl font-bold tracking-[-0.02em]">Plus everything the job needs.</h3>
            <p class="text-sm leading-[1.6] text-ink-500">Orders and supplier bills land on the job, so you can see what it’s really costing you.</p>
          </div>
          <ul class="flex flex-wrap gap-2 sm:justify-end">
            {supply.map((item) => <li class="rounded-full bg-chip px-3 py-1.5 text-sm text-ink-700">{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section id="site" class="bg-white text-ink-900">
      <div class="wrap py-14 sm:py-24 lg:pt-32 lg:pb-30 grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-[72px]">
        <div class="flex flex-col gap-5 lg:sticky lg:top-12 lg:gap-[18px] lg:self-start">
          <p class="eyebrow text-brand-700">03 — On site</p>
          <h2 class="heading-section lg:text-[52px] lg:leading-[1.04]">Built for the ute, not the desk.</h2>
          <p class="text-[17px] leading-[1.6] text-ink-600 lg:text-[19px]">The iPhone and iPad app runs on the same account as the office, and pings you when a job, message or task is yours.</p>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 sm:gap-4">
          {site.map((item) => (
            <li class="flex flex-col gap-4 rounded-2xl border border-line bg-mist p-6 sm:p-7">
              <span class="grid size-11 place-items-center rounded-xl bg-ink-900 text-white">
                <Icon name={item.icon} class="size-[22px]" stroke={1.8} />
              </span>
              <h3 class="font-display text-xl leading-[1.2] font-bold tracking-[-0.02em] lg:text-[22px]">{item.title}</h3>
              <p class="text-[15px] leading-[1.6] text-ink-600 sm:text-base">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="connects" class="border-t border-brand/18 bg-ground-800 text-white [--link:var(--color-brand)]">
      <div class="wrap py-14 sm:py-24 lg:py-32 flex flex-col gap-10 lg:gap-14">
        <div class="flex max-w-[860px] flex-col gap-5 lg:gap-[18px]">
          <p class="eyebrow text-brand">04 — Connects</p>
          <h2 class="heading-section">Works with what you already use.</h2>
        </div>
        <ul class="grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
          {integrations.map((item) => (
            <li class="flex flex-col gap-4 rounded-[18px] border border-white/12 bg-white/4 p-5 sm:p-6">
              <span class="grid size-11 place-items-center rounded-xl bg-white text-ink-900">
                {"src" in item ? <img loading="lazy" decoding="async" src={item.src} alt="" class="size-6 object-contain" width="24" height="24" /> : <Icon name={item.icon} class="size-[22px]" stroke={1.8} />}
              </span>
              <h3 class="font-display text-xl font-bold tracking-[-0.02em]">{item.name}</h3>
              <p class="text-[15px] leading-[1.55] text-fog-300">{item.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="questions" class="bg-mist text-ink-900">
      <div class="wrap py-14 sm:py-24 lg:pt-30 lg:pb-32 flex flex-col gap-10 lg:gap-14">
        <div class="flex flex-col gap-5 lg:gap-[18px]">
          <p class="eyebrow text-brand-700">05 — Questions</p>
          <h2 class="heading-section">Straight answers.</h2>
        </div>
        <dl class="grid gap-3 sm:gap-4 md:grid-cols-2">
          {faqs.map((faq) => (
            <div class="flex flex-col gap-3 rounded-2xl border border-line bg-white p-6 sm:p-7">
              <dt class="font-display text-xl leading-[1.2] font-bold tracking-[-0.02em] lg:text-[22px]">{faq.question}</dt>
              <dd class="text-[15px] leading-[1.6] text-ink-600 sm:text-base">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="early-access" class="dots scroll-mt-6 bg-ground text-white [--link:var(--color-brand)]">
      <div class="wrap py-20 lg:py-[120px] grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:items-center lg:gap-16">
        <div class="flex flex-col gap-6">
          <p class="eyebrow text-brand">Early access</p>
          <h2 class="font-display text-[44px] leading-none font-extrabold tracking-[-0.035em] text-balance sm:text-6xl lg:text-[68px]">
            On the tools all day. <span class="text-brand">Not on the admin all night.</span>
          </h2>
          <p class="max-w-[480px] text-[17px] leading-[1.6] text-pretty text-fog-300 lg:text-[19px]">
            We’re letting Aussie trade businesses in a few at a time. Tell us about yours and we’ll send you an invite code.
          </p>
          <p class="text-sm text-fog-400 lg:text-[15px]">
            Already have an account? <a href={SIGN_IN} class="font-semibold text-white underline underline-offset-4 hover:no-underline">Sign in</a>
          </p>
        </div>
        <EarlyAccessForm />
      </div>
    </section>
  </main>

  <SiteFooter />
</Layout>
